@article{dao2026irlopfb,
  title = {Model-Based and Off-Policy Data-Driven Inverse Reinforcement Learning for Linear Discrete-Time Two-Player Zero-Sum Games via Output Feedback},
  author = {Dao, Huy and Lai, Quoc Dat and Dao, Phuong Nam},
  journal = {Preprint},
  year = {2026},
  selected = {false},
  preview = {irl-output.png},
  website = {/projects/inverse-rl-output/},
  abstract = {Inverse reinforcement learning for linear discrete-time two-player zero-sum games under output feedback, with unknown dynamics. A model-based inverse policy iteration recovers an equivalent output-reward weight by imitating an expert. A model-free off-policy algorithm then uses only the expert's input-output-disturbance data. Simulations on an F-16 show the learner tracking the expert and meeting the designed disturbance attenuation.}
}
