@inproceedings{dao2026standing,
  abbr = {Under review},
  title = {Robust and Optimized Aggressive Standing-Up Maneuvers for Humanoid Robots across Diverse Terrains},
  author = {Nguyen*, Chuong and Dao*, Huy and Pham*, Loc and Nguyen, Truong and Nguyen, Quan},
  booktitle = {IEEE-RAS International Conference on Humanoid Robots (Humanoids)},
  year = {2026},
  selected = {true},
  preview = {standing-up.jpg},
  video = {assets/video/standing-up-intro.mp4},
  website = {/projects/standing-up/},
  bibtex_show = {true},
  note = {Under review.},
  abstract = {Aggressive standing-up for full-size humanoid robots on grass, debris, and other uneven surfaces. The method optimizes contact timing and a whole-body trajectory, then tracks it with a learned controller so the robot can get up from supine and prone postures, including martial-arts-style maneuvers. The study compares this approach with trajectory optimization paired with linear and nonlinear model predictive control. Chuong Nguyen, Huy Dao, and Loc Pham contributed equally. Affiliations: VinMotion, VinUniversity, and the University of Southern California.}
}

